# Copy to .env and fill in. Never commit .env.

# Notion internal integration secret (Settings > Connections > Develop or manage integrations)
NOTION_TOKEN=

# Fernet key used to encrypt tracking tokens. Generate with: notion-chimp gen-key
# Rotating it breaks every tracking link already sent.
NOTION_CHIMP_SECRET_KEY=

# Public base URL of your tracking server, no trailing slash, e.g. https://track.example.com
NOTION_CHIMP_BASE_URL=

# Kill switch. Any of 1/true/yes stops all sending and all Notion write-back.
NOTION_CHIMP_KILL_SWITCH=0

# Gmail OAuth files (only needed for the gmail sender)
GMAIL_CREDENTIALS_FILE=credentials.json
GMAIL_TOKEN_FILE=token.json

# SMTP (only needed for the smtp sender)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
